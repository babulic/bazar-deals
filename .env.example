# eBay Browse API (developer.ebay.com) — production needs app approval
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_DE
EBAY_CAMPAIGN_ID=

# Aukro Public API is sell-side; credentials after Aukro onboarding
AUKRO_API_TOKEN=

# Vinted Pro Integrations (allowlisted sell-side; split token into key + signing key)
VINTED_ACCESS_KEY=
VINTED_SIGNING_KEY=

# Optional LLM identification (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Telegram bot for paid/free deal channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_RETRO=
TELEGRAM_CHAT_MINERAL=
TELEGRAM_CHAT_APPLE=
TELEGRAM_CHAT_NETWORK=

# GitHub issue comments = email alerts (same pattern as polymarket-tracker / peer-order-finder)
GITHUB_TOKEN=
GITHUB_REPOSITORY=babulic/bazar-deals
GITHUB_ALERT_ISSUE=1
GITHUB_ASSIGNEE=babulic

# Hunt gates (override in .env)
MAX_BUY_EUR=60
MAX_PRICE_VS_TYPICAL=0.5
ALERT_PRICE_VS_TYPICAL=1.0
MAX_NO_COMP_ALERTS=5
MAX_SHIPPING_EUR=15
CHEAP_BUY_EUR=20
MAX_SHIPPING_CHEAP_EUR=11

# Sold-comps SQLite (hunt reads this first; eBay sold HTML only fills gaps)
COMPS_DB=.cache/bazar-comps.sqlite
COMPS_TTL_DAYS=7

