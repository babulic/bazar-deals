# eBay Browse API is sell-side only (own listings + European want-ads). Hunt does not use it.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Leave false while using the no-data-persistence exemption. Test only with
# python -m bazar_deals.ebay_probe; normal imports/reports are blocked.
# Enabling retention requires a working account-deletion process first.
EBAY_RETENTION_ENABLED=false
EBAY_MARKETPLACE=EBAY_DE
EBAY_CAMPAIGN_ID=

# Aukro Public API is sell-side; credentials after Aukro onboarding
AUKRO_API_TOKEN=

# Vinted Pro Integrations (allowlisted sell-side; split token into key + signing key)
VINTED_ACCESS_KEY=
VINTED_SIGNING_KEY=

# Final AI verifier. GitHub Actions uses Copilot CLI with the built-in token.
# Copilot Free/Student support auto model selection only. OpenAI remains an
# optional local provider and is not required by the scheduled workflow.
AI_PROVIDER=copilot
COPILOT_MODEL=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
AI_REVIEW_ENABLED=true
AI_REVIEW_REQUIRED=true
AI_MAX_REVIEWS=8
# Cap on AI identifications per hunt, so Copilot Free stays within budget.
AI_MAX_IDENTIFICATIONS=12
AI_REVIEW_TTL_DAYS=14
AI_MIN_CONFIDENCE=0.75
AI_TIMEOUT_SECONDS=90

# Telegram bot for paid/free deal channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_RETRO=
TELEGRAM_CHAT_MINERAL=
TELEGRAM_CHAT_APPLE=
TELEGRAM_CHAT_NETWORK=

# GitHub issue comments
GITHUB_TOKEN=
GITHUB_REPOSITORY=babulic/bazar-deals
GITHUB_ALERT_ISSUE=1
# Leave empty to auto-create a "Sell buyers" issue (label bazar-sell).
GITHUB_SELL_ALERT_ISSUE=
GITHUB_ASSIGNEE=babulic

# Hunt gates
MAX_BUY_EUR=110
MIN_BUY_EUR=20
MIN_NET_PROFIT_EUR=30
MAX_SHIPPING_EUR=15
CHEAP_BUY_EUR=20
MAX_SHIPPING_CHEAP_EUR=11

# Conservative cost/risk reserves
RESALE_FEE_RATE=0.10
SELLER_RISK_RESERVE_RATE=0.05
NO_BOX_HAIRCUT_EUR=5
BATTERY_UNDER_80_HAIRCUT_RATE=0.15
BATTERY_80_84_HAIRCUT_RATE=0.08
BATTERY_85_89_HAIRCUT_RATE=0.04

# Price book of discovered comparable asking prices (P25×0.75) + AI-reviewed values
COMPS_DB=.cache/bazar-comps-v2.sqlite
COMPS_TTL_DAYS=7

# Official Allegro /offers/listing access is required for both PL and SK.
ALLEGRO_ACCESS_TOKEN=
# Optional manual overrides (units of currency per EUR); blank = automatic ECB.
EUR_CZK=
EUR_PLN=

# Both currencies share one dated cache; old/future data are rejected.
FX_CACHE=.cache/ecb-fx.json
FX_MAX_AGE_DAYS=7

# Conservative conversion fee reserve for CZK/PLN (costs up, proceeds down)
FX_FEE_RATE=0.02

# Only for an application already entitled to /offers/listing. These do not grant access.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_LISTING_ACCESS_CONFIRMED=false
