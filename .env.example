# eBay Browse API: hunt purchase + price-book comps + sell want-ads.
# GitHub Actions hunt/sell set EBAY_RETENTION_ENABLED=true so Browse results
# can be stored. Local default stays false unless you opt in.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RETENTION_ENABLED=false
EBAY_MARKETPLACE=EBAY_DE
EBAY_CAMPAIGN_ID=

# Aukro Public API is sell-side; credentials after Aukro onboarding
AUKRO_API_TOKEN=

# Vinted Pro Integrations (allowlisted sell-side; split token into key + signing key)
VINTED_ACCESS_KEY=
VINTED_SIGNING_KEY=

# Final AI verifier. GitHub Actions uses Copilot CLI with the built-in token.
# Copilot Free/Student support auto selection only. Numeric AI budgets, models,
# and timeouts default from ai.* in src/bazar_deals/data/config.yaml.
AI_PROVIDER=copilot
OPENAI_API_KEY=
AI_REVIEW_ENABLED=true
AI_REVIEW_REQUIRED=true
# Optional local one-shot safety cap. Scheduled Hunt leaves this empty and
# bounds work with persisted pages instead of dropping the tail by time.
HUNT_SCORE_SECONDS=
# Hunt queue paths default from hunt.hunt_batch_db / hunt.batch_page_size.
# Scheduled Hunt uses the private deletion-aware service instead of a local DB.
HUNT_BATCH_URL=
HUNT_BATCH_TOKEN=

# Telegram bot for paid/free deal channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_RETRO=
TELEGRAM_CHAT_MINERAL=
TELEGRAM_CHAT_APPLE=
TELEGRAM_CHAT_NETWORK=

# GitHub issue comments
GITHUB_TOKEN=
GITHUB_REPOSITORY=babulic/bazar-deals
GITHUB_ALERT_ISSUE=1
# Leave empty to auto-create a "Sell buyers" issue (label bazar-sell).
GITHUB_SELL_ALERT_ISSUE=
GITHUB_ASSIGNEE=babulic
# Immediate hunt comments are BUY with net ≥ ALERT_MIN_NET_PROFIT_EUR.
# Otherwise one 0-BUY digest per calendar day in HUNT_DIGEST_TIMEZONE.
# Pagination/fetch Priebeh on the issue is debug-only (default off).
# HUNT_NOTIFY_PROGRESS=false
# HUNT_DIGEST_TIMEZONE=Europe/Bratislava

# Hunt gates, fees, battery haircuts, price-book TTL/sample, and P25 factor
# default from hunt.* / fees.* in src/bazar_deals/data/config.yaml.
# Uncomment only to override a catalog value, for example:
# MIN_NET_PROFIT_EUR=
# MIN_SOLD_SAMPLE=
# P25_FACTOR=

# Private eBay evaluation store; regular CLI retention stays disabled.
EBAY_STORE_URL=
EBAY_STORE_TOKEN=

# Official Allegro /offers/listing access is required for both PL and SK.
ALLEGRO_ACCESS_TOKEN=
# Optional manual overrides (units of currency per EUR); blank = automatic ECB.
EUR_CZK=
EUR_PLN=

# FX cache path and max age default from hunt.fx_cache / hunt.fx_max_age_days.
# FX_CACHE=
# FX_MAX_AGE_DAYS=
# FX_FEE_RATE=

# Only for an application already entitled to /offers/listing. These do not grant access.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_LISTING_ACCESS_CONFIRMED=false
